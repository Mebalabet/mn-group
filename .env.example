# Copy to .env and fill in for local dev, or set these as real environment
# variables on your host/PaaS for production. Only PORT has a safe default
# for everything below — the rest fall back to local/dev-friendly behavior
# when unset, EXCEPT JWT_SECRET, which server refuses to boot without in
# production (see config.js).

# ---- core ----
NODE_ENV=development
PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Public registration always creates a buyer account — there is no path from
# POST /api/auth/register to the admin role. To create or promote an admin
# account, run: npm run create-admin

# ---- database (optional — omit for the local JSON file store) ----
# Postgres connection string. When set, the app uses db/pgStore.js instead
# of the local data/db.json file. Run db/schema.sql against a fresh database
# once before first boot: psql "$DATABASE_URL" -f db/schema.sql
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---- object storage (optional — omit for local disk uploads/) ----
# Any S3-compatible provider: real AWS S3, or Cloudflare R2 / Backblaze B2 /
# DigitalOcean Spaces (leave S3_ENDPOINT unset for real AWS S3).
# S3_BUCKET=your-bucket-name
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=xxxxxxxx
# S3_SECRET_ACCESS_KEY=xxxxxxxx
# S3_PUBLIC_BASE_URL=

# ---- cross-origin (optional — omit if the frontend is served by this same app) ----
# Comma-separated list of allowed origins, only needed if the frontend is
# ever hosted on a different domain than this API.
# CORS_ORIGIN=https://app.yourdomain.com

# Set to "false" only if you are NOT behind any reverse proxy/load balancer
# (running Node directly exposed to the internet, which isn't recommended).
TRUST_PROXY=true
